\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Optimal $h$ for chiral symmetry.} In \textbf  {a)} The $h$ values are depicted which decouple $x$- and $y$-phonons. Those values were determined numerically by computing roots of $V_xy(h)$. A grid of $h$ values as initial guesses for the root algorithm was taken to have a better chance of finding all roots. In \textbf  {b)} $V_xy(b,h)$ is drawn for reference. Larger values of the function have been omitted to make the pattern of small coupling values more visible.}}{23}{figure.caption.40}\protected@file@percent }
\newlabel{fig:h_for_chirality}{{5}{23}{\textbf {Optimal $h$ for chiral symmetry.} In \textbf {a)} The $h$ values are depicted which decouple $x$- and $y$-phonons. Those values were determined numerically by computing roots of $V_xy(h)$. A grid of $h$ values as initial guesses for the root algorithm was taken to have a better chance of finding all roots. In \textbf {b)} $V_xy(b,h)$ is drawn for reference. Larger values of the function have been omitted to make the pattern of small coupling values more visible}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Energy spectrum for the chiral Hamiltonian.}The diagram was created with the parameter $a=1$. Blue and black colors depict the Energy spectrum for the $h$ values picked from the blue and black curves in Fig.\,\ref {fig:h_for_chirality} respectively.}}{23}{figure.caption.41}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Edge states}. The figure shows the decay of edge states with the four energies with the smallest absolute value. Each row depicts one energy state. Drawn in blue are the excitations of sublattice A, while the excitation of sublattice B is shown in red.}}{24}{figure.caption.42}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Decay of energy for topological states with atom number.}. In each row the eigenstate for the energy with smallest absolute value is plotted. Blue and red show again the excitations of sublattice A and B respectively. When moving down in the rows of the figure the atom number of the system is increased. It shows that with increasing atom number the energy of the topological decays. What also can be observed. That the decay-length of the excitations when moving away from the edges does not change with particle number.}}{25}{figure.caption.43}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces The diagram was created with the parameters $a=5$, $h=1.1$. Between the red and the olive dashed line, i.e. bewteen $b$-values of $2.25$-$2.73$ the winding number is 1, whereas right to the olive dashed line the winding number is 2.}}{30}{figure.caption.48}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The occurance of topological states is signaled by the vertical lines. Between the two red as well as between the two green lines topological states can be found.}}{34}{figure.caption.55}\protected@file@percent }
