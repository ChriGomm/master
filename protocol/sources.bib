@article{lohse_thouless_2016,
	title = {A Thouless quantum pump with ultracold bosonic atoms in an optical superlattice},
	volume = {12},
	rights = {2015 Springer Nature Limited},
	issn = {1745-2481},
	url = {https://www.nature.com/articles/nphys3584},
	doi = {10.1038/nphys3584},
	abstract = {Topological charge pumping enables the transport of charge through an adiabatic cyclic evolution of the underlying Hamiltonian. In contrast to classical transport, the transported charge is quantized and purely determined by the topology of the pump cycle, making it robust to perturbations. Here, we report on the realization of such a pump with ultracold bosonic atoms forming a Mott insulator in a dynamically controlled optical superlattice. By taking in situ images of the cloud, we observe a quantized deflection per pump cycle. We reveal the pump’s genuine quantum nature by showing that, in contrast to ground-state particles, a counterintuitive reversed deflection occurs for particles in the first excited band. Furthermore, we directly demonstrate that the system undergoes a controlled topological transition in higher bands when tuning the superlattice parameters. These results open a route to the implementation of more complex pumping schemes, including spin degrees of freedom and higher dimensions.},
	pages = {350--354},
	number = {4},
	journaltitle = {Nature Physics},
	shortjournal = {Nature Phys},
	author = {Lohse, M. and Schweizer, C. and Zilberberg, O. and Aidelsburger, M. and Bloch, I.},
	urldate = {2025-12-01},
	date = {2016-04},
	langid = {english},
	note = {Publisher: Nature Publishing Group},
	keywords = {Quantum simulation, Ultracold gases},
	file = {Full Text PDF:/home/christian/Zotero/storage/LRDP2LBU/Lohse et al. - 2016 - A Thouless quantum pump with ultracold bosonic atoms in an optical superlattice.pdf:application/pdf},
}

@article{meidan_topological_2011,
	title = {Topological classification of interaction-driven spin pumps},
	volume = {84},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.84.075325},
	doi = {10.1103/PhysRevB.84.075325},
	abstract = {When adiabatically varied in time, certain one-dimensional band insulators allow for the quantized noiseless pumping of spin even in the presence of strong spin-orbit scattering. These spin pumps are closely related to the quantum spin Hall system, and their properties are protected by a time-reversal restriction on the pumping cycle. In this paper we study pumps formed of one-dimensional insulators with a time-reversal restriction on the pumping cycle and a bulk energy gap which arises due to interactions. We find that the correlated gapped phase can lead to novel pumping properties. In particular, systems with 𝑑 different ground states can give rise to 𝑑+1 different classes of spin pumps, including a trivial class which does not pump quantized spin and 𝑑 nontrivial classes allowing for the pumping of quantized spin ℏ/𝑛 on average per cycle, where 1≤𝑛≤𝑑. We discuss an example of a spin pump that transfers an average of spin ℏ/2 without transferring charge.},
	pages = {075325},
	number = {7},
	journaltitle = {Physical Review B},
	shortjournal = {Phys. Rev. B},
	author = {Meidan, Dganit and Micklitz, Tobias and Brouwer, Piet W.},
	urldate = {2025-12-01},
	date = {2011-08-12},
	note = {Publisher: American Physical Society},
	file = {APS Snapshot:/home/christian/Zotero/storage/SRCWQYN3/PhysRevB.84.html:text/html;Full Text PDF:/home/christian/Zotero/storage/AY53Y7GS/Meidan et al. - 2011 - Topological classification of interaction-driven spin pumps.pdf:application/pdf},
}

@article{tangpanitanon_topological_2016,
	title = {Topological Pumping of Photons in Nonlinear Resonator Arrays},
	volume = {117},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.117.213603},
	doi = {10.1103/PhysRevLett.117.213603},
	abstract = {We show how to implement topological or Thouless pumping of interacting photons in one-dimensional nonlinear resonator arrays by simply modulating the frequency of the resonators periodically in space and time. The interplay between the interactions and the adiabatic modulations enables robust transport of Fock states with few photons per site. We analyze the transport mechanism via an effective analytic model and study its topological properties and its protection to noise. We conclude by a detailed study of an implementation with existing circuit-{QED} architectures.},
	pages = {213603},
	number = {21},
	journaltitle = {Physical Review Letters},
	shortjournal = {Phys. Rev. Lett.},
	author = {Tangpanitanon, Jirawat and Bastidas, Victor M. and Al-Assam, Sarah and Roushan, Pedram and Jaksch, Dieter and Angelakis, Dimitris G.},
	urldate = {2025-12-01},
	date = {2016-11-17},
	note = {Publisher: American Physical Society},
	file = {APS Snapshot:/home/christian/Zotero/storage/D4SZM5KY/PhysRevLett.117.html:text/html;Full Text PDF:/home/christian/Zotero/storage/CALSM7K3/Tangpanitanon et al. - 2016 - Topological Pumping of Photons in Nonlinear Resonator Arrays.pdf:application/pdf},
}

